# Banco de dados
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/NOME_DO_BANCO
DATABASE_URL="postgresql://admin:admin@localhost:5433/authdb"

# JWT
# Gere uma chave forte com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="troque-por-uma-string-longa-e-aleatoria"

# Admin único (semeado via `npx prisma db seed`)
ADMIN_NAME="Administrador"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="troque-por-uma-senha-forte"

# Login social Google
# Obtido em https://console.cloud.google.com/ -> APIs e Serviços -> Credenciais
GOOGLE_CLIENT_ID="seu-client-id-aqui.apps.googleusercontent.com"

# CORS - origem autorizada do frontend
FRONTEND_URL="http://localhost:4200"

# Porta da aplicação (opcional, padrão 3000 se omitido)
PORT=3000